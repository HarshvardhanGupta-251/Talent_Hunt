# ==============================================================================
# EYE WINN Literary & Cinematic Production Platform - Environment Variables
# Copy this file to .env before running in production
# ==============================================================================

# Server Port (default 3000)
PORT=3000

# Runtime Environment (development | production)
NODE_ENV=development

# Security Salt for cryptographic password hashing
PASSWORD_SALT="eyewinn_production_secure_salt_v2"

# Application Public Host URL
APP_URL="http://localhost:3000"

# Razorpay Gateway Configuration (Optional - simulation active by default)
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
