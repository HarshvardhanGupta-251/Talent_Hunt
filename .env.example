# ==============================================================================
# EYE WINN Literary & Cinematic Production Platform - Environment Variables
# Copy this file to .env before running in production
# ==============================================================================

# Server Port (default 3000)
PORT=3000

# Runtime Environment (development | production)
NODE_ENV=development

# Security Salt for cryptographic password hashing
PASSWORD_SALT="eyewinn_production_secure_salt_v2"

# Application Public Host URL
APP_URL="http://localhost:3000"

# Direct Client UPI Payment Configuration
# (Payments are directly deposited into the client's bank account via UPI QR / VPA.
# No third-party gateway, credit/debit card processors, or API keys required.)
DEFAULT_UPI_ID="eyewinnproductions@icici"
DEFAULT_UPI_PAYEE="EYE WINN PRODUCTIONS"

# Supabase Authentication & Database Integration (Optional - for cloud persistence)
# Set your Supabase project credentials below:
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

